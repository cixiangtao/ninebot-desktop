{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    "src/candidate-contracts.ts",
    "src/candidate-session-core.ts",
    "src/auth.ts",
    "src/passport-auth.ts",
    "src/passport-signer.ts",
    "src/passport-login-client.ts",
    "src/crypto-web.ts",
    "src/crypto-web-codec.ts",
    "src/transport-web.ts"
  ]
}
