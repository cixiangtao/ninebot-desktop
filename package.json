{
  "name": "ninebot-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "本地只读的九号骑行轨迹与速度回放客户端",
  "homepage": "https://github.com/cixiangtao/ninebot-desktop#readme",
  "bugs": {
    "url": "https://github.com/cixiangtao/ninebot-desktop/issues"
  },
  "license": "UNLICENSED",
  "author": {
    "name": "anys"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cixiangtao/ninebot-desktop.git"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "pnpm run prepare:ninecli-runtime && electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "preview": "pnpm run prepare:ninecli-runtime && electron-vite preview",
    "prepare:ninecli-runtime": "node scripts/prepare-ninecli-runtime.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "oxlint .",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "test": "vitest run",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "qa:recovery": "pnpm run build && node scripts/qa-recovery.mjs",
    "package:mac:dir": "pnpm run build && node scripts/qa-recovery.mjs && pnpm run prepare:ninecli-runtime -- --platform=darwin --arch=arm64 && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --arm64 --publish never -c.mac.identity=- -c.mac.hardenedRuntime=false && node scripts/verify-package.mjs && node scripts/qa-packaged.mjs",
    "package:mac:local": "pnpm run build && node scripts/qa-recovery.mjs && pnpm run prepare:ninecli-runtime -- --platform=darwin --arch=arm64 && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --arm64 --publish never -c.mac.identity=- -c.mac.hardenedRuntime=false && node scripts/verify-package.mjs --artifacts && node scripts/qa-packaged.mjs",
    "package:win:local": "pnpm run build && pnpm run prepare:ninecli-runtime -- --platform=win32 --arch=x64 && electron-builder --win nsis zip --x64 --publish never && node scripts/verify-package-windows.mjs --artifacts && node scripts/qa-packaged.mjs && node scripts/qa-windows-installer.mjs",
    "release:mac": "pnpm run check && pnpm run build && node scripts/qa-recovery.mjs && pnpm run prepare:ninecli-runtime -- --platform=darwin --arch=arm64 && electron-builder --mac dmg zip --arm64 --publish never -c.forceCodeSigning=true && node scripts/verify-package.mjs --release && node scripts/qa-packaged.mjs",
    "dist": "pnpm run package:mac:local"
  },
  "dependencies": {
    "gcoord": "1.0.7",
    "lucide-react": "1.34.0",
    "maplibre-gl": "6.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "fflate": "0.8.3",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "playwright": "1.62.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.17.1",
  "build": {
    "appId": "dev.anys.ninebot-desktop",
    "productName": "韭号出行",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "build/generated/runtime",
        "to": "runtime",
        "filter": [
          "ninecli/ninecli",
          "ninecli/ninecli.exe"
        ]
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "mac": {
      "artifactName": "ninebot-desktop-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "artifactName": "ninebot-desktop-${version}-win-${arch}.${ext}",
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "韭号出行"
    },
    "dmg": {
      "title": "韭号出行 ${version}",
      "backgroundColor": "#edf1f5",
      "window": {
        "width": 540,
        "height": 380
      }
    }
  }
}
